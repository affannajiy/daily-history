# Copy to .env and fill in. .env is gitignored.

# --- Required ---
# Primary writer. Free tier is region-dependent and may return limit: 0
# permanently; if that is your project, expect rich days to fail.
GEMINI_API_KEY=
# Fallback writer. Its 8,000 tokens-per-minute free tier cannot carry a full
# writing pass on its own, so it catches rather than leads.
GROQ_API_KEY=
RESEND_API_KEY=
RECIPIENT_EMAIL=

# --- Optional ---

# Only once you have verified a domain in Resend. Defaults to the shared
# onboarding@resend.dev sender, which works but lands in spam more often.
# FROM_EMAIL=History Today <news@yourdomain.com>

# Model overrides (defaults shown).
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.6-flash
