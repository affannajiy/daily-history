# Copy to .env and fill in. .env is gitignored.

# --- Required ---
GROQ_API_KEY=
RESEND_API_KEY=
RECIPIENT_EMAIL=

# --- Optional ---
# Fallback model. Free tier is region-dependent and may return limit: 0
# permanently — leave blank if so; the job stays on Groq.
GEMINI_API_KEY=

# Only once you have verified a domain in Resend. Defaults to the shared
# onboarding@resend.dev sender, which works but lands in spam more often.
# FROM_EMAIL=History Today <news@yourdomain.com>

# Model overrides (defaults shown).
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.0-flash
